# Populate Neon-managed values with: neon env pull
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_FUNCTION_HELLO_BASE_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Generate once; keep this same secret in the PHP host and Function deployment.
ORIGIN_SECRET=
# Set to your app's public origin when deploying the PHP frontend elsewhere.
APP_ORIGIN=http://127.0.0.1:8080
# Optional: PEM CA bundle for PHP/libpq when not configured in php.ini.
# PGSSLROOTCERT=C:/path/to/ca-bundle.crt
